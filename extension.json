	"APIModules": {
		"aibatcheditorlist": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorList",
			"services": [
				"AIBatchEditor.PageContentService",
				"AIBatchEditor.BatchLogService",
				"AIBatchEditor.RateLimiterService"
			]
		},
		"aibatcheditorpreview": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorPreview",
			"services": [
				"AIBatchEditor.PageContentService",
				"AIBatchEditor.PromptFactory",
				"AIBatchEditor.TemplateSourceService"
			]
		},
		"aibatcheditorbatchstart": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorBatchStart",
			"services": [
				"AIBatchEditor.PageContentService",
				"AIBatchEditor.BatchRunService",
				"AIBatchEditor.BatchLogService",
				"AIBatchEditor.TemplateSourceService"
			]
		},
		"aibatcheditorbatchstatus": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorBatchStatus",
			"services": [
				"AIBatchEditor.BatchRunService"
			]
		},
		"aibatcheditorbatchadvance": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorBatchAdvance",
			"services": [
				"AIBatchEditor.BatchRunService",
				"AIBatchEditor.BatchLogService"
			]
		},
		"aibatcheditorbatchcancel": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorBatchCancel",
			"services": [
				"AIBatchEditor.BatchRunService",
				"AIBatchEditor.BatchLogService"
			]
		},
		"aibatcheditordiff": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorDiff",
			"services": [
				"AIBatchEditor.DiffService"
			]
		},
		"aibatcheditorarticlepreview": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorArticlePreview",
			"services": [
				"AIBatchEditor.ArticlePreviewService",
				"AIBatchEditor.PageContentService"
			]
		},
		"aibatcheditorsave": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorSave",
			"services": [
				"AIBatchEditor.EditService",
				"AIBatchEditor.BatchLogService",
				"AIBatchEditor.DraftTokenService"
			]
		},
		"aibatcheditorrefreshdrafttokens": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorRefreshDraftTokens",
			"services": [
				"AIBatchEditor.EditService",
				"AIBatchEditor.DraftTokenService"
			]
		}
	},
	"SpecialPages": {
		"AIBatchEditor": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\SpecialAIBatchEditor",
			"services": [
				"PermissionManager",
				"MainConfig",
				"AIBatchEditor.RateLimiterService"
			]
		},
		"AIBatchEditorArticlePreview": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\SpecialAIBatchEditorArticlePreview",
			"services": [
				"AIBatchEditor.ArticlePreviewService"
			]
		}
	},
	"ExtensionMessagesFiles": {
		"AIBatchEditorAlias": "AIBatchEditor.alias.php"
	},
	"AvailableRights": [
		"aibatchedit"
	],
	"GroupPermissions": {
		"sysop": {
			"aibatchedit": true
		}
	},
	"config": {
		"AIBatchEditorApiUrl": {
			"value": "",
			"description": "Grok-compatible chat completions endpoint URL. Server-side only."
		},
		"AIBatchEditorApiKey": {
			"value": "",
			"description": "API key/bearer token for the LLM endpoint. Server-side only; never exposed to clients."
		},
		"AIBatchEditorModel": {
			"value": "grok-4.3",
			"description": "Grok model identifier passed to the chat completions endpoint."
		},
		"AIBatchEditorMaxBatch": {
			"value": 100,
			"description": "Maximum number of pages allowed in a single batch run."
		},
		"AIBatchEditorMaxPageSize": {
			"value": 2097152,
			"description": "Maximum wikitext size in bytes per page before AI processing is rejected (default 2 MiB). 0 disables the limit."
		},
		"AIBatchEditorMaxInstructionsLength": {
			"value": 8192,
			"description": "Maximum length in bytes for AI instruction text sent to the LLM."
		},
		"AIBatchEditorRequestTimeout": {
			"value": 420,
			"description": "HTTP timeout in seconds for each LLM request (grok-4.x on large pages often needs 5–7 minutes)."
		},
		"AIBatchEditorTemperature": {
			"value": 0.1,
			"description": "LLM sampling temperature (0.0–1.0). Lower values follow instructions more strictly."
		},
		"AIBatchEditorPromptPreview": {
			"value": false,
			"description": "Debug flag: expose built LLM prompts in the UI and API responses. Enable only for troubleshooting."
		},
		"AIBatchEditorRateLimitPerHour": {
			"value": 500,
			"description": "Maximum AI completion requests per user per hour (must cover large batch runs)."
		},
		"AIBatchEditorConcurrency": {
			"value": 1,
			"description": "Number of pages processed per batch advance request (LLM calls run in parallel when > 1)."
		},
		"AIBatchEditorReasoningEffort": {
			"value": "",
			"description": "Optional xAI reasoning effort for models that support it (low|medium|high). Empty omits the parameter (provider default; grok-4.5 defaults to high)."
		},
		"AIBatchEditorDraftTokenSecret": {
			"value": "",
			"description": "Optional HMAC secret for draft tokens. When empty, uses $wgSecretKey. Set explicitly if token signatures fail across PHP workers."
		},
		"AIBatchEditorPollIntervalMs": {
			"value": 2500,
			"description": "Client interval in milliseconds between batch status polls while a batch is running."
		},
		"AIBatchEditorStubMode": {
			"value": false,
			"description": "Use a deterministic AI stub instead of HTTP (for automated browser tests only)."
		},
		"AIBatchEditorDefaultProfile": {
			"value": "balanced",
			"description": "Default aggressiveness profile when the client does not specify one."
		},
		"AIBatchEditorEnabledOperations": {
			"value": {
				"wikilinks": true,
				"spellcheck": true,
				"formatting": true,
				"style": true,
				"templates": true,
				"custom": true
			},
			"description": "Toggle which AI operations are available to users."
		},
		"AIBatchEditorTemplateSourceWiki": {
			"value": "https://es.wikipedia.org",
			"description": "Default remote wiki base URL for fetching reference templates (HTTPS only)."
		},
		"AIBatchEditorTemplateSourceAllowHosts": {
			"value": [
				"es.wikipedia.org",
				"en.wikipedia.org",
				"www.mediawiki.org"
			],
			"description": "Allowed hostnames for templatesource overrides and remote template fetches."
		},
		"AIBatchEditorSystemPrompt": {
			"value": [],
			"description": "Wiki-wide context inserted at the start of every LLM system prompt (after ROLE, before OUTPUT CONTRACT). Use for wiki identity only; do not put operation-specific checklists here."
		},
		"AIBatchEditorSystemPromptAppend": {
			"value": [],
			"description": "Extra bullet points appended to every LLM system prompt for wiki-wide policy. Does not replace built-in safety rules; operation task and scope take precedence over editor instructions."
		},
		"AIBatchEditorOperationProfiles": {
			"value": {
				"wikilinks": {
					"conservative": "Fewest links: only where editor instructions name a target.",
					"balanced": "Editor instructions plus clearly notable terms in each paragraph.",
					"aggressive": "All reasonable links within scope on the page."
				},
				"spellcheck": {
					"conservative": "Only clear typos and errors named in editor instructions.",
					"balanced": "All obvious typos in prose.",
					"aggressive": "Every misspelling found in prose within scope."
				},
				"formatting": {
					"conservative": "Fix only structure problems mentioned in editor instructions.",
					"balanced": "Fix clear structure problems throughout.",
					"aggressive": "Restructure formatting thoroughly for readability within scope."
				},
				"style": {
					"conservative": "Rephrase only sentences flagged by instructions or with obvious clarity issues.",
					"balanced": "Improve clarity in all prose that benefits without changing meaning.",
					"aggressive": "Rewrite all prose for neutral encyclopedic tone within scope."
				},
				"templates": {
					"conservative": "Minimal parameter fill for templates named in editor instructions.",
					"balanced": "Apply template changes from instructions using references.",
					"aggressive": "Full insert, upgrade, or clone per instructions and references."
				},
				"custom": {
					"conservative": "Smallest sufficient edit to satisfy instructions.",
					"balanced": "Complete satisfaction of instructions on every page.",
					"aggressive": "Exhaustive literal completion of everything instructions request."
				}
			},
			"description": "Per-operation profile intensity (how much to change within scope). Shown in the UI and sent to the LLM."
		}
	},
	"manifest_version": 2
}