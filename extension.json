	"APIModules": {
		"aibatcheditorlist": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorList",
			"services": [
				"AIBatchEditor.PageContentService",
				"AIBatchEditor.BatchLogService",
				"AIBatchEditor.RateLimiterService"
			]
		},
		"aibatcheditorpreview": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorPreview",
			"services": [
				"AIBatchEditor.PageContentService",
				"AIBatchEditor.PromptFactory",
				"AIBatchEditor.TemplateSourceService"
			]
		},
		"aibatcheditorbatchstart": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorBatchStart",
			"services": [
				"AIBatchEditor.PageContentService",
				"AIBatchEditor.BatchRunService",
				"AIBatchEditor.BatchLogService",
				"AIBatchEditor.TemplateSourceService"
			]
		},
		"aibatcheditorbatchstatus": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorBatchStatus",
			"services": [
				"AIBatchEditor.BatchRunService",
				"AIBatchEditor.BatchLogService"
			]
		},
		"aibatcheditordiff": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorDiff",
			"services": [
				"AIBatchEditor.DiffService"
			]
		},
		"aibatcheditorsave": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorSave",
			"services": [
				"AIBatchEditor.EditService",
				"AIBatchEditor.BatchLogService",
				"AIBatchEditor.DraftTokenService"
			]
		}
	},
	"SpecialPages": {
		"AIBatchEditor": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\SpecialAIBatchEditor",
			"services": [
				"PermissionManager",
				"MainConfig",
				"AIBatchEditor.RateLimiterService"
			]
		}
	},
	"ExtensionMessagesFiles": {
		"AIBatchEditorAlias": "AIBatchEditor.alias.php"
	},
	"AvailableRights": [
		"aibatchedit"
	],
	"GroupPermissions": {
		"sysop": {
			"aibatchedit": true
		}
	},
	"config": {
		"AIBatchEditorApiUrl": {
			"value": "",
			"description": "Grok-compatible chat completions endpoint URL. Server-side only."
		},
		"AIBatchEditorApiKey": {
			"value": "",
			"description": "API key/bearer token for the LLM endpoint. Server-side only; never exposed to clients."
		},
		"AIBatchEditorModel": {
			"value": "grok-2-latest",
			"description": "Grok model identifier passed to the chat completions endpoint."
		},
		"AIBatchEditorMaxBatch": {
			"value": 50,
			"description": "Maximum number of pages allowed in a single batch run."
		},
		"AIBatchEditorMaxPageSize": {
			"value": 2097152,
			"description": "Maximum wikitext size in bytes per page before AI processing is rejected (default 2 MiB). 0 disables the limit."
		},
		"AIBatchEditorMaxInstructionsLength": {
			"value": 8192,
			"description": "Maximum length in bytes for AI instruction text sent to the LLM."
		},
		"AIBatchEditorRequestTimeout": {
			"value": 120,
			"description": "HTTP timeout in seconds for each LLM request."
		},
		"AIBatchEditorTemperature": {
			"value": 0.1,
			"description": "LLM sampling temperature (0.0–1.0). Lower values follow instructions more strictly."
		},
		"AIBatchEditorPromptPreview": {
			"value": false,
			"description": "Debug flag: expose built LLM prompts in the UI and API responses. Enable only for troubleshooting."
		},
		"AIBatchEditorRateLimitPerHour": {
			"value": 100,
			"description": "Maximum AI completion requests per user per hour."
		},
		"AIBatchEditorConcurrency": {
			"value": 3,
			"description": "Number of pages the server processes per batch status poll."
		},
		"AIBatchEditorStubMode": {
			"value": false,
			"description": "Use a deterministic AI stub instead of HTTP (for automated browser tests only)."
		},
		"AIBatchEditorDefaultProfile": {
			"value": "balanced",
			"description": "Default aggressiveness profile when the client does not specify one."
		},
		"AIBatchEditorEnabledOperations": {
			"value": {
				"wikilinks": true,
				"spellcheck": true,
				"formatting": true,
				"style": true,
				"templates": true,
				"custom": true
			},
			"description": "Toggle which AI operations are available to users."
		},
		"AIBatchEditorTemplateSourceWiki": {
			"value": "https://es.wikipedia.org",
			"description": "Default remote wiki base URL for fetching reference templates (HTTPS only)."
		},
		"AIBatchEditorTemplateSourceAllowHosts": {
			"value": [
				"es.wikipedia.org",
				"en.wikipedia.org",
				"www.mediawiki.org"
			],
			"description": "Allowed hostnames for templatesource overrides and remote template fetches."
		},
		"AIBatchEditorSystemPromptAppend": {
			"value": [],
			"description": "Extra bullet points appended to every LLM system prompt for wiki-wide policy. Does not replace built-in safety rules; editor instructions still take precedence."
		},
		"AIBatchEditorOperationProfiles": {
			"value": {
				"wikilinks": {
					"conservative": "Add wikilinks only where editor instructions or obvious terms require them.",
					"balanced": "Add wikilinks requested by editor instructions and for clearly notable terms.",
					"aggressive": "Add all wikilinks requested by editor instructions plus every plausible link."
				},
				"spellcheck": {
					"conservative": "Fix only errors explicitly mentioned in editor instructions or clear typos.",
					"balanced": "Fix spelling and grammar requested in editor instructions and obvious mistakes.",
					"aggressive": "Fix all spelling and grammar issues while honoring editor instructions first."
				},
				"formatting": {
					"conservative": "Adjust formatting only where editor instructions require it.",
					"balanced": "Apply formatting changes from editor instructions and fix clear structure problems.",
					"aggressive": "Restructure formatting fully per editor instructions and readability needs."
				},
				"style": {
					"conservative": "Rephrase prose only where editor instructions ask; never alter wikitext structure or markup.",
					"balanced": "Improve prose clarity from editor instructions; preserve all headings, lists, templates, and layout exactly.",
					"aggressive": "Rewrite prose for encyclopedic tone per editor instructions; still copy every markup line unchanged unless instructions target it."
				},
				"templates": {
					"conservative": "Insert or update only the templates and parameters named in editor instructions.",
					"balanced": "Apply template changes from editor instructions using reference definitions and page content.",
					"aggressive": "Fully insert, upgrade, or clone templates per editor instructions and reference wikitext."
				},
				"custom": {
					"conservative": "Follow editor instructions exactly with the smallest sufficient edit.",
					"balanced": "Follow editor instructions exactly and completely for every page.",
					"aggressive": "Follow editor instructions literally and exhaustively; leave nothing requested undone."
				}
			},
			"description": "Per-operation aggressiveness instructions sent to the LLM."
		}
	},
	"manifest_version": 2
}