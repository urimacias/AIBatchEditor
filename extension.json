	"APIModules": {
		"aibatcheditorlist": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorList",
			"services": [
				"AIBatchEditor.PageContentService",
				"AIBatchEditor.BatchLogService"
			]
		},
		"aibatcheditorprocess": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorProcess",
			"services": [
				"AIBatchEditor.PageContentService",
				"AIBatchEditor.AIService",
				"AIBatchEditor.PromptFactory",
				"AIBatchEditor.RateLimiterService",
				"AIBatchEditor.BatchLogService",
				"AIBatchEditor.TemplateSourceService"
			]
		},
		"aibatcheditordiff": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorDiff",
			"services": [
				"AIBatchEditor.DiffService"
			]
		},
		"aibatcheditorsave": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\Api\\ApiAIBatchEditorSave",
			"services": [
				"AIBatchEditor.EditService",
				"AIBatchEditor.BatchLogService"
			]
		}
	},
	"SpecialPages": {
		"AIBatchEditor": {
			"class": "MediaWiki\\Extension\\AIBatchEditor\\SpecialAIBatchEditor",
			"services": [
				"PermissionManager",
				"MainConfig"
			]
		}
	},
	"ExtensionMessagesFiles": {
		"AIBatchEditorAlias": "AIBatchEditor.alias.php"
	},
	"AvailableRights": [
		"aibatchedit"
	],
	"GroupPermissions": {
		"sysop": {
			"aibatchedit": true
		}
	},
	"config": {
		"AIBatchEditorApiUrl": {
			"value": "",
			"description": "Grok-compatible chat completions endpoint URL. Server-side only."
		},
		"AIBatchEditorApiKey": {
			"value": "",
			"description": "API key/bearer token for the LLM endpoint. Server-side only; never exposed to clients."
		},
		"AIBatchEditorModel": {
			"value": "grok-2-latest",
			"description": "Grok model identifier passed to the chat completions endpoint."
		},
		"AIBatchEditorMaxBatch": {
			"value": 50,
			"description": "Maximum number of pages allowed in a single batch run."
		},
		"AIBatchEditorMaxPageSize": {
			"value": 51200,
			"description": "Maximum wikitext size in bytes per page before AI processing is rejected. 0 disables the limit."
		},
		"AIBatchEditorMaxInstructionsLength": {
			"value": 8192,
			"description": "Maximum length in bytes for AI instruction text sent to the LLM."
		},
		"AIBatchEditorRequestTimeout": {
			"value": 120,
			"description": "HTTP timeout in seconds for each LLM request."
		},
		"AIBatchEditorRateLimitPerHour": {
			"value": 100,
			"description": "Maximum AI completion requests per user per hour."
		},
		"AIBatchEditorConcurrency": {
			"value": 3,
			"description": "Number of pages to process in parallel in the browser UI."
		},
		"AIBatchEditorDefaultProfile": {
			"value": "balanced",
			"description": "Default aggressiveness profile when the client does not specify one."
		},
		"AIBatchEditorEnabledOperations": {
			"value": {
				"wikilinks": true,
				"spellcheck": true,
				"formatting": true,
				"style": true,
				"templates": true,
				"custom": true
			},
			"description": "Toggle which AI operations are available to users."
		},
		"AIBatchEditorTemplateSourceWiki": {
			"value": "https://es.wikipedia.org",
			"description": "Default remote wiki base URL for fetching reference templates (HTTPS only)."
		},
		"AIBatchEditorTemplateSourceAllowHosts": {
			"value": [
				"es.wikipedia.org",
				"en.wikipedia.org",
				"www.mediawiki.org"
			],
			"description": "Allowed hostnames for templatesource overrides and remote template fetches."
		},
		"AIBatchEditorOperationProfiles": {
			"value": {
				"wikilinks": {
					"conservative": "Add wikilinks only for the most obvious and unambiguous article titles.",
					"balanced": "Add helpful wikilinks for notable terms that likely have articles.",
					"aggressive": "Add comprehensive wikilinks for all plausible article titles."
				},
				"spellcheck": {
					"conservative": "Fix only clear spelling mistakes; do not change grammar or wording.",
					"balanced": "Fix spelling and obvious grammatical errors.",
					"aggressive": "Fix spelling, grammar, and punctuation thoroughly."
				},
				"formatting": {
					"conservative": "Adjust whitespace and line breaks only when clearly broken.",
					"balanced": "Improve headings, lists, and paragraph structure without changing content.",
					"aggressive": "Restructure formatting for maximum readability."
				},
				"style": {
					"conservative": "Make minimal clarity tweaks; preserve the original voice.",
					"balanced": "Improve clarity and flow while preserving meaning and tone.",
					"aggressive": "Rewrite for strong clarity and consistent encyclopedic tone."
				},
				"templates": {
					"conservative": "Add or update only the specified template transclusion with minimal parameter changes.",
					"balanced": "Insert or upgrade template transclusions using reference definitions; fill obvious parameters from page content.",
					"aggressive": "Fully insert, upgrade, or clone templates from the reference wiki, adapting parameters and structure thoroughly."
				},
				"custom": {
					"conservative": "Follow instructions with the smallest possible changes.",
					"balanced": "Follow instructions with moderate thoroughness.",
					"aggressive": "Follow instructions as completely as possible."
				}
			},
			"description": "Per-operation aggressiveness instructions sent to the LLM."
		}
	},
	"manifest_version": 2
}